+#[tokio::test]
+async fn comail_mailbox_space_round_trips_authority_records() {
+    use sha2::Digest as _;
+
+    let s = setup().await;
+    let (status, body) = post_json(
+        &s.client,
+        "/xrpc/com.atproto.simplespace.createSpace",
+        &s.author_token,
+        json!({"type": "email.atmos.mailbox", "skey": "primary"}),
+    )
+    .await;
+    assert_eq!(status, Status::Ok, "{body}");
+    let mailbox_space = body["uri"].as_str().unwrap().to_string();
+    assert_eq!(
+        mailbox_space,
+        format!("at://{AUTHOR_DID}/space/email.atmos.mailbox/primary")
+    );
+
+    let raw = b"Message-ID: <rsky-mailbox@example.test>\r\nSubject: isolated proof\r\n\r\nprivate body\r\n";
+    let response = s
+        .client
+        .post("/xrpc/com.atproto.repo.uploadBlob")
+        .header(ContentType::new("message", "rfc822"))
+        .header(bearer(&s.author_token))
+        .body(raw.as_slice())
+        .dispatch()
+        .await;
+    assert_eq!(response.status(), Status::Ok);
+    let upload: Value = response.into_json().await.unwrap();
+    let blob = upload["blob"].clone();
+    let blob_cid = blob["ref"]["$link"].as_str().unwrap().to_string();
+    let sha256 = hex::encode(sha2::Sha256::digest(raw));
+    let rkey = format!("sha256-{sha256}");
+    let folder_rkey = "folder-inbox";
+
+    let (status, body) = post_json(
+        &s.client,
+        "/xrpc/com.atproto.space.applyWrites",
+        &s.author_token,
+        json!({
+            "space": mailbox_space,
+            "repo": AUTHOR_DID,
+            "validate": false,
+            "writes": [
+                {"action": "create", "collection": "email.atmos.folder", "rkey": folder_rkey,
+                 "value": {"$type": "email.atmos.folder", "name": "INBOX", "role": "inbox",
+                           "uidValidity": 1, "revision": 1, "updatedAt": "1970-01-01T00:00:00Z"}},
+                {"action": "create", "collection": "email.atmos.message", "rkey": rkey,
+                 "value": {"$type": "email.atmos.message", "raw": blob, "sha256": sha256,
+                           "size": raw.len(), "deliveryFingerprint": rkey, "initialMailbox": "INBOX"}},
+                {"action": "create", "collection": "email.atmos.messageState", "rkey": rkey,
+                 "value": {"$type": "email.atmos.messageState", "message": rkey,
+                           "mailboxIds": [folder_rkey], "keywords": ["$seen"],
+                           "revision": 1, "updatedAt": "1970-01-01T00:00:00Z"}}
+            ]
+        }),
+    )
+    .await;
+    assert_eq!(status, Status::Ok, "{body}");
+    assert_eq!(body["results"].as_array().unwrap().len(), 3);
+
+    for collection in [
+        "email.atmos.folder",
+        "email.atmos.message",
+        "email.atmos.messageState",
+    ] {
+        let (status, body) = get_json(
+            &s.client,
+            &format!(
+                "/xrpc/com.atproto.space.listRecords?space={mailbox_space}&repo={AUTHOR_DID}&collection={collection}"
+            ),
+            &s.author_token,
+        )
+        .await;
+        assert_eq!(status, Status::Ok, "{body}");
+        assert_eq!(body["records"].as_array().unwrap().len(), 1, "{body}");
+    }
+
+    let response = s
+        .client
+        .get(format!(
+            "/xrpc/com.atproto.space.getBlob?space={mailbox_space}&repo={AUTHOR_DID}&cid={blob_cid}"
+        ))
+        .header(bearer(&s.author_token))
+        .dispatch()
+        .await;
+    assert_eq!(response.status(), Status::Ok);
+    assert_eq!(response.into_bytes().await.unwrap(), raw);
+
+    // A different authenticated account cannot use its session token to read
+    // the private mailbox space, even when it knows the exact CID.
+    let response = s
+        .client
+        .get(format!(
+            "/xrpc/com.atproto.space.getBlob?space={mailbox_space}&repo={AUTHOR_DID}&cid={blob_cid}"
+        ))
+        .header(bearer(&s.member_token))
+        .dispatch()
+        .await;
+    assert_ne!(response.status(), Status::Ok);
+}
