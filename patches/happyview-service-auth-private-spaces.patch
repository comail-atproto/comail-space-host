@@ -396,0 +401,15 @@ async fn require_auth_or_credential(
+/// Resolve a caller DID for private-space discovery. Space credentials are not
+/// accepted here because they represent delegated access to records, while a
+/// verified service identity can itself be granted normal space membership.
+fn require_identity_or_service_auth(claims: &XrpcClaims) -> Result<String, AppError> {
+    if let Some(identity) = &claims.identity {
+        return Ok(identity.did().to_string());
+    }
+    if let Some(service_auth) = &claims.service_auth {
+        return Ok(service_auth.did.clone());
+    }
+    Err(AppError::Auth(
+        "This endpoint requires authentication".into(),
+    ))
+}
