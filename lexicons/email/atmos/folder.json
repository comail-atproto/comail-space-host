{
  "lexicon": 1,
  "id": "email.atmos.folder",
  "defs": {
    "main": {
      "type": "record",
      "description": "Experimental folder definition for one Comail mailbox space.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["name", "revision", "updatedAt"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "role": {
            "type": "string",
            "knownValues": [
              "inbox",
              "archive",
              "drafts",
              "sent",
              "junk",
              "trash",
              "important"
            ],
            "maxLength": 64
          },
          "uidValidity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "updatedAt": {
            "type": "string",
            "format": "datetime"
          }
        }
      }
    }
  }
}
