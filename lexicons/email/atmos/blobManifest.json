{
  "lexicon": 1,
  "id": "email.atmos.blobManifest",
  "defs": {
    "main": {
      "type": "record",
      "description": "Experimental HappyView compatibility manifest for private message/rfc822 chunks.",
      "key": "any",
      "record": {
        "type": "object",
        "required": ["sha256", "size", "mimeType", "chunks"],
        "properties": {
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10485760
          },
          "mimeType": {
            "type": "string",
            "knownValues": ["message/rfc822"],
            "maxLength": 64
          },
          "chunks": {
            "type": "array",
            "minLength": 1,
            "maxLength": 32,
            "items": {
              "type": "ref",
              "ref": "#chunkRef"
            }
          }
        }
      }
    },
    "chunkRef": {
      "type": "object",
      "required": ["rkey", "sha256", "size"],
      "properties": {
        "rkey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 393216
        }
      }
    }
  }
}
