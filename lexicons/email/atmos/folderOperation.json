{
  "lexicon": 1,
  "id": "email.atmos.folderOperation",
  "defs": {
    "main": {
      "type": "record",
      "description": "ALPHA. Immutable operation claim created atomically with one folder revision. Its deterministic key is scoped to the author repository, stable folder ID, and operation ID, so a retry with changed payload collides safely.",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "folderId",
          "operationId",
          "revisionRkey"
        ],
        "properties": {
          "folderId": {
            "type": "string",
            "minLength": 71,
            "maxLength": 71
          },
          "operationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revisionRkey": {
            "type": "string",
            "description": "Content-committing email.atmos.folderRevision record key.",
            "minLength": 77,
            "maxLength": 77
          }
        }
      }
    }
  }
}
