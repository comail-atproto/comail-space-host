{
  "spaceType": "email.atmos.mailbox",
  "version": 1,
  "cardinality": "one-space-per-email-account",
  "collections": [
    {
      "nsid": "email.atmos.message",
      "authority": "immutable"
    },
    {
      "nsid": "email.atmos.messageState",
      "authority": "mutable-experimental",
      "requires": ["compare-and-swap"]
    },
    {
      "nsid": "email.atmos.folder",
      "authority": "mutable-experimental",
      "requires": ["compare-and-swap"]
    },
    {
      "nsid": "email.atmos.blobChunk",
      "authority": "happyview-private-compatibility"
    },
    {
      "nsid": "email.atmos.blobManifest",
      "authority": "happyview-private-compatibility"
    },
    {
      "nsid": "email.atmos.blobIndex",
      "authority": "happyview-private-compatibility"
    }
  ],
  "portableRebuild": ["listRecords", "getBlob"],
  "optionalAccelerators": ["listRepoOps", "getRepo", "registerNotify"]
}
